# Local / demo
DATABASE_URL="file:./prisma/dev.db"

# Production: use Postgres on Vercel / Neon / Supabase
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/tansiq?sslmode=require"

# OTP — mock by default (devCode returned + demo bypass 1234)
OTP_PROVIDER="mock"
