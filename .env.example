# Local / demo (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Vercel / production — REQUIRED for orders, admin writes, and persistent style rules.
# Create a free Neon or Supabase Postgres DB, then in Vercel → Project → Settings → Environment Variables:
#   DATABASE_URL = postgresql://USER:PASS@HOST/db?sslmode=require
# Without it, the app still deploys and Style/catalog run from the static catalog fallback.
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/tansiq?sslmode=require"

# OTP — mock by default (devCode returned + demo bypass 1234)
OTP_PROVIDER="mock"
# OTP_PROVIDER="sms"
# SMS_API_KEY=""
# SMS_API_URL=""

# WhatsApp / notify stub — without key, notifications are "simulated"
# WHATSAPP_API_KEY=""

# Buyer support WhatsApp (wa.me) — Phase 3
NEXT_PUBLIC_SUPPORT_WHATSAPP="966500000000"
# SUPPORT_WHATSAPP="966500000000"
